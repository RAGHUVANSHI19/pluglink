{
  "name": "pluglink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web --passthrough-arguments \"npm run dev:api\" \"npm run dev --workspace frontend -- {@}\" --",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "npm run dev --workspace frontend",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run db:generate && npm run build --workspace backend && npm run build --workspace frontend",
    "start": "node backend/dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.22.5"
    }
  }
}
