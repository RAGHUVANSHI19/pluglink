# The Docker Compose database credentials are for local development only.
DATABASE_URL=postgresql://pluglink:pluglink@localhost:5432/pluglink?schema=public
PORT=3001
APP_ORIGIN=http://localhost:5173

# Use the exact trusted reverse-proxy hop count when your host documents one.
TRUST_PROXY=0

# The seed and reset token display are development-only.
DEMO_PASSWORD=PlugLinkDemo2026!
AUTH_ALLOW_DEMO_RESET=true

# Optional Razorpay sandbox keys. Leave all three blank for local simulated checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional password reset delivery from a verified Resend sender.
RESEND_API_KEY=
RESET_FROM_EMAIL=

# Optional absolute directory backed by a persistent volume on hosted deployments.
UPLOAD_DIR=

# Minimum lead time in minutes to cancel a future booking.
CANCELLATION_CUTOFF_MINUTES=0

# Optional separate migrated PostgreSQL database for automated integration tests.
TEST_DATABASE_URL=
